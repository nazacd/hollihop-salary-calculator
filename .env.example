# HolliHop API base URL, e.g. https://yourschool.t8s.ru/Api/V2
BASE_URL=https://yourschool.t8s.ru/Api/V2
# HolliHop API key (Settings → API in HolliHop)
AUTHKEY=your-auth-key

# Optional: your teacher id in HolliHop. If omitted you can pick yourself in the UI.
TEACHER_ID=
# Optional: protect the site with HTTP basic auth (any username, this password)
APP_PASSWORD=
# Optional: port to listen on (default 3000)
PORT=3000
